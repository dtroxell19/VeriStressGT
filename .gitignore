__pycache__/
*.py[cod]
*.swp
.venv/
.env
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Artifacts
*.onnx
*.pt
*.npy
*.npz

# Keep toy example assets tracked
!examples/toy_weights.pt
!examples/toy_instance.npz
!examples/toy_spec.vnnlib

# Benchmark / run artifacts (generated at evaluation time)
*_bench/
*_run/
*_run */
results.json

# Pre-built mini_sweep benchmark committed for reproducibility
!mini_sweep_bench/
!mini_sweep_bench/**

# Track committed benchmark models (needed to actually run the benchmarks); never commit the
# stale external-data blobs the older exporter left behind.
!src/VeriStressGT/benchmarks/**/*.onnx
src/VeriStressGT/benchmarks/**/*.onnx.data
